load "$NCARG_NCARG/nclscripts/csm/gsn_code.ncl"  
load "$NCARG_NCARG/nclscripts/csm/gsn_csm.ncl"  
load "$NCARG_NCARG/nclscripts/csm/contributed.ncl"
load "shapefile_utils.ncl"
load "ensRPS1.ncl"
begin

  ; Read in ensemble indices (0-199) for each of the 400 randomization sets generated by NCL function
  ; generate_sample_indices.
  esel = onedtond(asciiread("ens_rand.inf", -1, "integer"), (/ 400, 200 /))

  Tmax_obs = new((/ 121, 7, 10 /), "float")
  ; Read in observations into Tmax_obs

  rps = new((/ 200, 121, 6, 10 /), "float")

    do e = 0, 199
     do t = 0, 5
      do s = 0, 9
       do dy = 1, ndays

        if(.not. any(ismissing(Tmax(:, dy - 1, t, s)))) then
         if(e .eq. 0) then
           ens_num = esel(set, e)
           rps(e, tb + dy - 1, t, s) = abs(Tmax(ens_num, dy - 1, t, s) - Tmax_obs(tb + dy - 1, t, s))
         else
           ens_nums = esel(set, 0:e)
           Tmax_mod = Tmax(ens_nums, dy - 1, t, s)
           ireal = ind(.not. ismissing(Tmax_mod))
           nreal = dimsizes(ireal)
           if(.not. all(ismissing(ireal))) then
             Tmax_sort = Tmax_mod(ireal)
             qsort(Tmax_sort)            ; Sort forecast values in order
             rps(e, tb + dy - 1, t, s) = ensRPS1(Tmax_sort, Tmax_obs(tb + dy - 1, t, s)) ; ensRPS1 calculates CRPS
             delete(Tmax_sort)
           end if
           delete(ens_nums)
           delete(Tmax_mod)
           delete(ireal)
         end if
        end if

       end do

      end do
     end do
    end do
    delete(imo)

  end do

  dimNames = (/ "ens", "time", "lead", "basin" /)
  dimSizes = (/ 200, 121, 6, 10 /)
  dimUnlim = (/ False, False, False, False /)

  ; Write CRPS to file
  system("rm -f wrfcf_fullrand" + set + "_rps_HUC2-18.Tmax.nc")
  fout = addfile("wrfcf_fullrand" + set + "_rps_HUC2-18.Tmax.nc", "c")
  setfileoption(fout, "DefineMode", True)

  filedimdef(fout, dimNames, dimSizes, dimUnlim)
  filevardef(fout, "RPS", typeof(rps), dimNames)
  setfileoption(fout, "DefineMode", False)

  fout->RPS = (/ rps /)
  delete(fout)

end

