load "$NCARG_NCARG/nclscripts/csm/gsn_code.ncl"  
load "$NCARG_NCARG/nclscripts/csm/gsn_csm.ncl"  
load "$NCARG_NCARG/nclscripts/csm/contributed.ncl"
load "shapefile_utils.ncl"
begin

  ; Read in ensemble indices (0-199) for each of the 400 randomization sets generated by NCL function
  ; generate_sample_indices.
  esel = onedtond(asciiread("ens_rand.inf", -1, "integer"), (/ 400, 200 /))

  Tmax_obs = new((/ 400, 200, 121, 6, 10 /), "float") ; (# rand set, # ens, # days, # lead days, # subregions)
  ; Read in observations into Tmax_obs

  Tmax_climo = new((/ 121, 6, 10 /), "float") ; (# days, # lead days, # subregions)
  ; Read in obs. climatology into Tmax_climo

  se = new((/ 400, 200, 121, 6, 10 /), "float")
  se!0 = "set"
  se!1 = "ens"
  se!2 = "time"
  se!3 = "lead"
  se!4 = "basin"
  ens_Tmax = se
  sc = new((/ 121, 6, 10 /), "float")
  avg_ss = new((/ 200, 6 /), "float")
  
  do dy = 0, 120

    ; Calculate climatological SE
    do dy = 1, ndays
      sc(dy, :, :) = (Tmax_climo(dy, :, :) - Tmax_obs(0, 0, dy, :, :))^2.
    end do

    ; Calculate ensemble mean forecasts
    do e = 0, 399
      do f = 0, 199

        if(f .eq. 0) then
          ens_nums = esel(e, f)
          ens_Tmax(e, f, dy, :, :) = Tmax(ens_nums, dy, :, :)
        else
          ens_nums = esel(e, 0:f)
          ens_Tmax(e, f, dy, :, :) = dim_avg_n(Tmax(ens_nums, dy, :, :), 0)
        end if
        delete(ens_nums)

      end do
    end do

  end do

  ; Calculate forecast SE
  se = (ens_Tmax - Tmax_obs)^2.

  do t = 0, 5 ; over lead day

    se_t = se(ens|:, set|:, time|:, lead|t, basin|:)
    do n = 0, 199                                       ; over ensemble size
      reg_mse = dim_avg_n(se_t(n, :, :, :), (/ 1, 2 /)) ; Average over randomization sets
      all_mse = avg(reg_mse)                            ; Average over all days and basins
      avg_ss(n, t) = 1. - (all_mse / avg(sc(:, t, :)))
    end do

    delete(se_t)

  end do

  dimNames = (/ "set", "ens", "time" /)
  dimSizes = (/ 400, 200, 6 /)
  dimUnlim = (/ False, False, False /)

  ; Write out MSSSensm to file
  system("rm -f wrfcf_fullrand_MSSSensm_HUC2-18.Tmax.nc")
  fout = addfile("wrfcf_fullrand_MSSSensm_HUC2-18.Tmax.nc", "c")
  setfileoption(fout, "DefineMode", True)

  filedimdef(fout, dimNames, dimSizes, dimUnlim)
  filevardef(fout, "SS_avg", typeof(avg_ss), dimNames(1:2))
  setfileoption(fout, "DefineMode", False)

  fout->SS_avg = (/ avg_ss /)
  delete(fout)

end

